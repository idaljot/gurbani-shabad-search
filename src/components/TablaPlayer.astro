  }
  .tabla-beats {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  /* .bol/.dot are created at runtime via document.createElement (see
     renderBeats() below), so they never receive Astro's scoping attribute —
     these rules must be :global() or they silently never match. */
  :global(.tabla-beats .bol) {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.65rem;
    color: var(--muted, #7a7068);
