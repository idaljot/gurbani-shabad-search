---
import { TAALS, DEFAULT_TAAL } from '../data/taals.js';

const {
  id,
  variant = 'embedded',
  presetTaal,
  presetTempo,
  presetKey,
} = Astro.props;

const taalNames = Object.keys(TAALS);
const selectDefault = presetTaal && TAALS[presetTaal] ? presetTaal : DEFAULT_TAAL;
const isFloating = variant === 'floating';

// The embedded variant (shabad detail pages) renders this widget fully
// expanded and visible from the very first paint — unlike the floating
// homepage widget, which starts collapsed. The client script populates
// the beat row / beat count / tempo value via JS on load, which on an
// embedded player was a real, visible empty-to-populated layout shift
// (Lighthouse flagged div.panels.two on detail pages for exactly this).
// Pre-rendering the same markup server-side, from the same preset taal
// the client script would use, means the client's initial setTaal/setTempo
// calls just replace it with identical content — no reflow.
const initialTaal = TAALS[selectDefault];
const initialTempo = presetTempo || initialTaal.defaultTempo;

// Tanpura Sa: the shabad's Key field ("C#", "Bb", …) when it parses as a
// note name, else C.
const KEY_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const FLATS = { Db: 'C#', Eb: 'D#', Gb: 'F#', Ab: 'G#', Bb: 'A#' };
function parseKey(raw) {
  const m = String(raw || '').trim().match(/^([A-Ga-g])\s*([#b♯♭])?/);
  if (!m) return null;
  const name = m[1].toUpperCase() + ({ '#': '#', '♯': '#', b: 'b', '♭': 'b' }[m[2]] || '');
  return FLATS[name] || (KEY_NAMES.includes(name) ? name : null);
}
const initialKey = parseKey(presetKey) || 'C';
---

<div
  class={`tabla-player tabla-player--${variant}`}
  data-tabla-player
  id={id}
  data-preset-taal={presetTaal && TAALS[presetTaal] ? presetTaal : undefined}
  data-preset-tempo={presetTempo || undefined}
  data-preset-key={parseKey(presetKey) || undefined}
>
  {isFloating && (
    <div class="tabla-header" data-role="header">
      <button type="button" class="tabla-play tabla-play--small" data-role="play" aria-label="Play taal">&#9654;</button>
      <div class="tabla-header-info">
        <span class="tabla-header-taal" data-role="taal-label"></span>
        <span class="tabla-header-bpm" data-role="tempo-label"></span>
      </div>
      <button type="button" class="tabla-chevron" data-role="toggle" aria-label="Expand tabla player" aria-expanded="false">&#9650;</button>
    </div>
  )}

  <div class="tabla-body" data-role="body">
    <div class="tabla-controls-row">
      {!isFloating && (
        <button type="button" class="tabla-play" data-role="play" aria-label="Play taal">&#9654;</button>
      )}
      <select class="tabla-select" data-role="taal-select" aria-label="Taal">
        {taalNames.map((name) => (
          <option value={name} selected={name === selectDefault}>{name}</option>
        ))}
      </select>
      <label class="tabla-tempo">
        <input
          type="range"
          min="40"
          max="200"
          step="1"
          value={initialTempo}
          data-role="tempo-range"
          aria-label="Tempo (BPM)"
        />
        <span data-role="tempo-value">{initialTempo}</span> BPM
      </label>
      <label class="tabla-bell-toggle">
        <input type="checkbox" data-role="bell-toggle" /> Bell on beat 1
      </label>
      <button type="button" class="tabla-fullscreen-btn" data-role="fullscreen" aria-label="Fullscreen mode">&#9974;</button>
    </div>

    <div class="tabla-tanpura-row">
      <button type="button" class="tabla-tanpura-btn" data-role="tanpura-toggle" aria-pressed="false">Tanpura</button>
      <label>
        Sa
        <select class="tabla-select tabla-select--small" data-role="tanpura-key" aria-label="Tanpura key (Sa)">
          {KEY_NAMES.map((k) => <option value={k} selected={k === initialKey}>{k}</option>)}
        </select>
      </label>
      <label>
        1st string
        <select class="tabla-select tabla-select--small" data-role="tanpura-first" aria-label="Tanpura first string">
          <option value="P" selected>Pa</option>
          <option value="M">Ma</option>
          <option value="N">Ni</option>
        </select>
      </label>
    </div>

    <div class="tabla-visualizer" data-role="visualizer">
      <button type="button" class="tabla-fs-close" data-role="fullscreen-close" aria-label="Exit fullscreen">&times;</button>
      <p class="tabla-taal-name" data-role="fs-taal-name"></p>
      <p class="tabla-current-beat" data-role="current-beat" aria-label="Current beat">1</p>
      <p class="tabla-beat-count" data-role="beat-count">{initialTaal.beats.length} beat{initialTaal.beats.length === 1 ? '' : 's'}</p>
      <div class="tabla-beats" data-role="beats">
        {initialTaal.beats.map((bol, i) => (
          <div class={`bol${i === 0 ? ' sam' : ''}`} data-index={i}>
            <span class="dot"></span><span>{bol}</span>
          </div>
        ))}
      </div>
      <div class="tabla-fs-controls" data-role="fs-controls">
        <button type="button" class="tabla-play" data-role="fs-play" aria-label="Play taal">&#9654;</button>
        <select class="tabla-select" data-role="fs-taal-select" aria-label="Taal">
          {taalNames.map((name) => (
            <option value={name} selected={name === selectDefault}>{name}</option>
          ))}
        </select>
        <label class="tabla-tempo">
          <input
            type="range"
            min="40"
            max="200"
            step="1"
            value={initialTempo}
            data-role="fs-tempo-range"
            aria-label="Tempo (BPM)"
          />
          <span data-role="fs-tempo-value">{initialTempo}</span> BPM
        </label>
        <label class="tabla-bell-toggle">
          <input type="checkbox" data-role="fs-bell-toggle" /> Bell on beat 1
        </label>
        <div class="tabla-tanpura-row">
          <button type="button" class="tabla-tanpura-btn" data-role="tanpura-toggle" aria-pressed="false">Tanpura</button>
          <label>
            Sa
            <select class="tabla-select" data-role="tanpura-key" aria-label="Tanpura key (Sa)">
              {KEY_NAMES.map((k) => <option value={k} selected={k === initialKey}>{k}</option>)}
            </select>
          </label>
          <label>
            1st string
            <select class="tabla-select" data-role="tanpura-first" aria-label="Tanpura first string">
              <option value="P" selected>Pa</option>
              <option value="M">Ma</option>
              <option value="N">Ni</option>
            </select>
          </label>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tabla-player {
    font: inherit;
  }
  .tabla-play {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--border, #e5dccb);
