    inset: 0;
    z-index: 9999;
  }
  .tabla-visualizer:fullscreen .tabla-fs-close,
  .tabla-visualizer.tabla-fs-fallback .tabla-fs-close {
    display: flex;
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border, #e5dccb);
    background: #fff;
    align-items: center;
