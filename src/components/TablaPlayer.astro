    font-size: 0.95rem;
    padding: 0.4rem 1rem;
  }
</style>

<script>
  import { TAALS, DEFAULT_TAAL, BOL_ALIASES, BASE_BOLS, SAMPLE_TAKES } from '../data/taals.js';

  const PITCHES = {
    dha: 'A1',
    dhin: 'C2',
    na: 'E2',
    tin: 'G2',
    ta: 'D2',
    ge: 'B1',
    ke: 'F2',
    tun: 'G2',
    te: 'F2',
  };

  let currentTaalName = DEFAULT_TAAL;
  let currentBpm = TAALS[DEFAULT_TAAL].defaultTempo;
  let sequence = null;
  let isPlaying = false;
  let step = 0;
  let bellEnabled = false;
  let bellBuffer = null;
  const synths = {};
  // base bol -> array of loaded takes (sparse until each take loads)
  const sampleBuffers = {};
  const lastTake = {};
  const instances = [];

  function loadTake(base, n) {
    const file = n === 1 ? `/tabla/${base}.wav` : `/tabla/${base}-${n}.wav`;
    return window.Tone.ToneAudioBuffer.load(file)
      .then((buffer) => { (sampleBuffers[base] ||= [])[n - 1] = buffer; })
      .catch(() => {});
  }

  // Real recordings win when present (see public/tabla/README.md); any bol
  // without a matching file falls back to the synthesized placeholder below.
  // Take 1 of each bol loads with the page; extra takes only load once
  // someone actually presses play, so idle page views don't pay for them.
  BASE_BOLS.forEach((base) => loadTake(base, 1));
  let extraTakesRequested = false;
  function loadExtraTakes() {
    if (extraTakesRequested) return;
    extraTakesRequested = true;
    Object.entries(SAMPLE_TAKES).forEach(([base, count]) => {
      for (let n = 2; n <= count; n++) loadTake(base, n);
    });
  }

  // Random loaded take, avoiding the one used last time for this bol.
  function pickTake(base) {
    const takes = (sampleBuffers[base] || []).map((b, i) => (b ? i : -1)).filter((i) => i >= 0);
    if (takes.length === 0) return null;
    const options = takes.length > 1 ? takes.filter((i) => i !== lastTake[base]) : takes;
    const i = options[Math.floor(Math.random() * options.length)];
    lastTake[base] = i;
    return sampleBuffers[base][i];
  }

  window.Tone.ToneAudioBuffer.load('/tabla/bell.wav')
    .then((buffer) => { bellBuffer = buffer; })
    .catch(() => {});

  function triggerBell(time) {
    if (!bellBuffer) return;
    const player = new window.Tone.Player(bellBuffer).toDestination();
    player.onstop = () => player.dispose();
    player.start(time);
  }

  function getSynth(bol) {
    const base = BOL_ALIASES[bol] || bol.toLowerCase();
    if (!synths[base]) {
      synths[base] = new window.Tone.MembraneSynth({
        envelope: { attack: 0.001, decay: 0.3, sustain: 0 },
      }).toDestination();
    }
    return { synth: synths[base], base };
  }

  function triggerBol(bol, time) {
    const base = BOL_ALIASES[bol] || bol.toLowerCase();
    const buffer = pickTake(base);
    if (buffer) {
      const player = new window.Tone.Player(buffer).toDestination();
      // Tiny per-stroke variation (±~7 cents, ±1.5 dB), like a real hand.
      player.playbackRate = 1 + (Math.random() * 2 - 1) * 0.004;
      player.volume.value = (Math.random() * 2 - 1) * 1.5;
      player.onstop = () => player.dispose();
      player.start(time);
    } else {
      const { synth } = getSynth(bol);
      synth.triggerAttackRelease(PITCHES[base] || 'C2', '8n', time);
    }
  }

  // ---- Tanpura drone -------------------------------------------------------
  // Synthesized (no samples, so no licensing) and independent of the tabla:
  // it has its own clock, so it can play alone or under the theka at any
  // tempo. Classic 4-string pattern: first string (mandra Pa, or Ma/Ni for
  // raags without Pa), Sa, Sa, kharaj Sa (an octave below), then a pause.
  const FIRST_STRING_OFFSET = { P: -5, M: -7, N: -1 }; // semitones from Sa
  const NOTE_INDEX = { C: 0, 'C#': 1, D: 2, 'D#': 3, E: 4, F: 5, 'F#': 6, G: 7, 'G#': 8, A: 9, 'A#': 10, B: 11 };
  const TANPURA_TICK = 0.25; // seconds
  const TANPURA_PLUCKS = { 0: 'first', 5: 'sa', 9: 'sa', 13: 'kharaj' }; // tick -> string
  const TANPURA_CYCLE = 20; // ticks (5 s)
  let tanpuraKey = 'C';
  let tanpuraFirst = 'P';
  let tanpuraOn = false;
  let tanpuraSynth = null;
  let tanpuraClock = null;
  let tanpuraTick = 0;

  function tanpuraFreq(string) {
    // Sa in the octave starting at C3 (~131–247 Hz), a comfortable range.
    const sa = 130.81 * Math.pow(2, NOTE_INDEX[tanpuraKey] / 12);
    const semis = { first: FIRST_STRING_OFFSET[tanpuraFirst], sa: 0, kharaj: -12 }[string];
    return sa * Math.pow(2, semis / 12);
  }

  function ensureTanpura() {
    if (tanpuraSynth) return;
    const Tone = window.Tone;
    // Bright, slowly decaying string: many harmonics, gently low-passed, with
    // a little reverb so plucks overlap into a continuous drone.
    const reverb = new Tone.Reverb({ decay: 4, wet: 0.35 }).toDestination();
    const filter = new Tone.Filter(2200, 'lowpass').connect(reverb);
    tanpuraSynth = new Tone.PolySynth(Tone.Synth, {
      oscillator: { type: 'custom', partials: [1, 0.7, 0.55, 0.45, 0.4, 0.32, 0.27, 0.22, 0.18, 0.15, 0.12, 0.1, 0.08, 0.06] },
      envelope: { attack: 0.015, decay: 3.5, sustain: 0.15, release: 3 },
      volume: -16,
    }).connect(filter);
    tanpuraSynth.maxPolyphony = 12;
    tanpuraClock = new Tone.Clock((time) => {
      const string = TANPURA_PLUCKS[tanpuraTick % TANPURA_CYCLE];
      tanpuraTick++;
      if (string) {
        const detune = 1 + (Math.random() * 2 - 1) * 0.0015;
        tanpuraSynth.triggerAttackRelease(tanpuraFreq(string) * detune, 3.5, time);
      }
    }, 1 / TANPURA_TICK);
  }

  async function toggleTanpura() {
    await window.Tone.start();
    ensureTanpura();
    tanpuraOn = !tanpuraOn;
    if (tanpuraOn) {
      tanpuraTick = 0;
      tanpuraClock.start();
    } else {
      tanpuraClock.stop();
      tanpuraSynth.releaseAll();
    }
    instances.forEach((inst) => {
      inst.tanpuraBtns.forEach((btn) => btn.setAttribute('aria-pressed', String(tanpuraOn)));
    });
  }

  function setTanpuraKey(key) {
    if (!(key in NOTE_INDEX)) return;
    tanpuraKey = key;
    instances.forEach((inst) => inst.tanpuraKeySelects.forEach((sel) => { sel.value = key; }));
  }

  function setTanpuraFirst(first) {
    if (!(first in FIRST_STRING_OFFSET)) return;
    tanpuraFirst = first;
    instances.forEach((inst) => inst.tanpuraFirstSelects.forEach((sel) => { sel.value = first; }));
  }

  function renderBeats(beatsEl, taalName) {
    const taal = TAALS[taalName];
    beatsEl.innerHTML = '';
    taal.beats.forEach((bol, i) => {
      const el = document.createElement('div');
      el.className = 'bol' + (i === 0 ? ' sam' : '');
      el.dataset.index = String(i);
      el.innerHTML = `<span class="dot"></span><span>${bol}</span>`;
      beatsEl.appendChild(el);
    });
  }

  function highlightBeat(index) {
    instances.forEach((inst) => {
      inst.beatsEl.querySelectorAll('.bol').forEach((el) => el.classList.remove('active'));
      const target = inst.beatsEl.querySelector(`[data-index="${index}"]`);
      if (target) target.classList.add('active');
    });
  }

  function updateBeatNumber(index) {
    instances.forEach((inst) => {
      if (inst.currentBeatEl) inst.currentBeatEl.textContent = String(index + 1);
    });
  }

  function onBeat(index) {
    highlightBeat(index);
    updateBeatNumber(index);
  }

  // Shows the sam (beat 1) as the idle/reset state, both when playback is
  // stopped and right before a fresh play so every start begins the visible
  // count at 1 rather than resuming wherever the last cycle left off.
  function resetBeatDisplay() {
    highlightBeat(0);
    updateBeatNumber(0);
  }

  function rebuildSequence() {
    if (sequence) {
      sequence.dispose();
      sequence = null;
    }
    const taal = TAALS[currentTaalName];
    step = 0;
    sequence = new window.Tone.Sequence(
      (time, bol) => {
        const index = step % taal.beats.length;
        step++;
        if (bol !== '-') {
          triggerBol(bol, time);
        }
        if (index === 0 && bellEnabled) {
          triggerBell(time);
        }
        window.Tone.Draw.schedule(() => onBeat(index), time);
      },
      taal.beats,
      '4n',
    );
    if (isPlaying) sequence.start(0);
  }

  function updateHeaderLabels() {
    instances.forEach((inst) => {
      if (inst.taalLabel) inst.taalLabel.textContent = currentTaalName;
      if (inst.tempoLabel) inst.tempoLabel.textContent = `${currentBpm} BPM`;
      if (inst.fsTaalName) inst.fsTaalName.textContent = currentTaalName;
    });
  }

  function setTaal(name) {
    if (!TAALS[name]) return;
    currentTaalName = name;
    rebuildSequence();
    instances.forEach((inst) => {
      inst.select.value = name;
      if (inst.fsTaalSelect) inst.fsTaalSelect.value = name;
      renderBeats(inst.beatsEl, name);
      if (inst.beatCountEl) {
        const count = TAALS[name].beats.length;
        inst.beatCountEl.textContent = `${count} beat${count === 1 ? '' : 's'}`;
      }
    });
    resetBeatDisplay();
    updateHeaderLabels();
  }

  function setTempo(bpm) {
    currentBpm = bpm;
    window.Tone.Transport.bpm.value = bpm;
    instances.forEach((inst) => {
      inst.tempoRange.value = String(bpm);
      inst.tempoValue.textContent = String(bpm);
      if (inst.fsTempoRange) inst.fsTempoRange.value = String(bpm);
      if (inst.fsTempoValue) inst.fsTempoValue.textContent = String(bpm);
    });
    updateHeaderLabels();
  }

  function setBellEnabled(enabled) {
    bellEnabled = enabled;
    instances.forEach((inst) => {
      if (inst.bellToggle) inst.bellToggle.checked = enabled;
      if (inst.fsBellToggle) inst.fsBellToggle.checked = enabled;
    });
  }

  async function togglePlay() {
    await window.Tone.start();
    loadExtraTakes();
    if (!sequence) rebuildSequence();
    if (isPlaying) {
      window.Tone.Transport.stop();
      sequence.stop();
      isPlaying = false;
      resetBeatDisplay();
    } else {
      step = 0;
      resetBeatDisplay();
      sequence.start(0);
      window.Tone.Transport.start();
      isPlaying = true;
    }
    instances.forEach((inst) => {
      inst.playBtn.innerHTML = isPlaying ? '&#10074;&#10074;' : '&#9654;';
      if (inst.fsPlayBtn) inst.fsPlayBtn.innerHTML = isPlaying ? '&#10074;&#10074;' : '&#9654;';
    });
  }

  function toggleExpanded(inst) {
    const expanded = inst.el.classList.toggle('expanded');
    inst.toggleBtn.setAttribute('aria-expanded', String(expanded));
    inst.toggleBtn.innerHTML = expanded ? '&#9660;' : '&#9650;';
  }

  function isVisualizerFullscreen(inst) {
    return document.fullscreenElement === inst.visualizerEl || inst.visualizerEl.classList.contains('tabla-fs-fallback');
  }

  async function enterFullscreen(inst) {
    if (inst.visualizerEl.requestFullscreen) {
      try {
        await inst.visualizerEl.requestFullscreen();
        return;
      } catch (err) {
        // fall through to CSS fallback
      }
    }
    inst.visualizerEl.classList.add('tabla-fs-fallback');
  }

  function exitFullscreen(inst) {
    if (document.fullscreenElement === inst.visualizerEl) {
      document.exitFullscreen();
    }
    inst.visualizerEl.classList.remove('tabla-fs-fallback');
  }

  function toggleFullscreen(inst) {
    if (isVisualizerFullscreen(inst)) {
      exitFullscreen(inst);
    } else {
      enterFullscreen(inst);
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    instances.forEach((inst) => {
      if (inst.visualizerEl.classList.contains('tabla-fs-fallback')) {
        inst.visualizerEl.classList.remove('tabla-fs-fallback');
      }
    });
  });

  document.querySelectorAll('[data-tabla-player]').forEach((el) => {
    const inst = {
      el,
      playBtn: el.querySelector('[data-role="play"]'),
      select: el.querySelector('[data-role="taal-select"]'),
      tempoRange: el.querySelector('[data-role="tempo-range"]'),
      tempoValue: el.querySelector('[data-role="tempo-value"]'),
      beatsEl: el.querySelector('[data-role="beats"]'),
      beatCountEl: el.querySelector('[data-role="beat-count"]'),
      currentBeatEl: el.querySelector('[data-role="current-beat"]'),
      visualizerEl: el.querySelector('[data-role="visualizer"]'),
      fullscreenBtn: el.querySelector('[data-role="fullscreen"]'),
      fullscreenCloseBtn: el.querySelector('[data-role="fullscreen-close"]'),
      toggleBtn: el.querySelector('[data-role="toggle"]'),
      taalLabel: el.querySelector('[data-role="taal-label"]'),
      tempoLabel: el.querySelector('[data-role="tempo-label"]'),
      fsTaalName: el.querySelector('[data-role="fs-taal-name"]'),
      fsPlayBtn: el.querySelector('[data-role="fs-play"]'),
      fsTaalSelect: el.querySelector('[data-role="fs-taal-select"]'),
      fsTempoRange: el.querySelector('[data-role="fs-tempo-range"]'),
      fsTempoValue: el.querySelector('[data-role="fs-tempo-value"]'),
      bellToggle: el.querySelector('[data-role="bell-toggle"]'),
      fsBellToggle: el.querySelector('[data-role="fs-bell-toggle"]'),
      // Tanpura controls appear twice per player (main row + fullscreen).
      tanpuraBtns: el.querySelectorAll('[data-role="tanpura-toggle"]'),
      tanpuraKeySelects: el.querySelectorAll('[data-role="tanpura-key"]'),
      tanpuraFirstSelects: el.querySelectorAll('[data-role="tanpura-first"]'),
    };
    instances.push(inst);
    inst.playBtn.addEventListener('click', togglePlay);
    inst.select.addEventListener('change', (e) => setTaal(e.target.value));
    inst.tempoRange.addEventListener('input', (e) => setTempo(Number(e.target.value)));
    inst.fullscreenBtn.addEventListener('click', () => toggleFullscreen(inst));
    inst.fullscreenCloseBtn.addEventListener('click', () => exitFullscreen(inst));
    if (inst.toggleBtn) inst.toggleBtn.addEventListener('click', () => toggleExpanded(inst));
    if (inst.fsPlayBtn) inst.fsPlayBtn.addEventListener('click', togglePlay);
    if (inst.fsTaalSelect) inst.fsTaalSelect.addEventListener('change', (e) => setTaal(e.target.value));
    if (inst.fsTempoRange) inst.fsTempoRange.addEventListener('input', (e) => setTempo(Number(e.target.value)));
    if (inst.bellToggle) inst.bellToggle.addEventListener('change', (e) => setBellEnabled(e.target.checked));
    if (inst.fsBellToggle) inst.fsBellToggle.addEventListener('change', (e) => setBellEnabled(e.target.checked));
    inst.tanpuraBtns.forEach((btn) => btn.addEventListener('click', toggleTanpura));
    inst.tanpuraKeySelects.forEach((sel) => sel.addEventListener('change', (e) => setTanpuraKey(e.target.value)));
    inst.tanpuraFirstSelects.forEach((sel) => sel.addEventListener('change', (e) => setTanpuraFirst(e.target.value)));
  });

  const presetEl = document.querySelector('[data-tabla-player][data-preset-taal]');
  const initTaal = presetEl?.dataset.presetTaal || DEFAULT_TAAL;
  const initTempo = Number(presetEl?.dataset.presetTempo) || TAALS[initTaal]?.defaultTempo || 90;
  setTaal(initTaal);
  setTempo(initTempo);
  setTanpuraKey(document.querySelector('[data-tabla-player][data-preset-key]')?.dataset.presetKey || 'C');
</script>
